{
  "name": "Lector Documental Pro",
  "short_name": "Lector PDF",
  "start_url": "./index.html",
  "display": "fullscreen",
  "background_color": "#0e0e11",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/72x72/1f4d6.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/72x72/1f4d6.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Documentos PDF",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
